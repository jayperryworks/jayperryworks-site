---
/**
 * Gallery component
 * - display a list of things in a fluid grid
 *
 * @param {boolean} [alignContentHorizontally]
 * @param {boolean} [alignContentVertically]
 * @param {string} [class] - append classes to the container
 * @param {boolean} [constrainContent] - constrain content to a default width
 * @param {SpaceScale} [gutter] - the space between items
 * @param {GallerySize} [size] - how wide the columns can get
 * @param {boolean} [useFlexBox] - display with flexbox
 */
import '@shared/styles/tokens/contentWidth.css';
import '@shared/styles/tokens/spacing.css';

// types
import type { SpaceScale, GallerySize } from '@shared/lib/types';

const {
	alignContentHorizontally = false,
	alignContentVertically = false,
	class: className = '',
	constrainContent = false,
	gutter = 'xnarrow',
	size = 'medium',
} = Astro.props;

const classList = ['gallery', className].join(' ').trim();
---

<ul
	class={classList}
	data-align={[
		alignContentHorizontally ? 'center justify' : '',
		alignContentVertically ? 'center' : '',
	]
		.join(' ')
		.trim()}
	data-column-width={size}
	data-constrain={constrainContent || undefined}
	style={`--gutter: var(--space-${gutter});`}
>
	<slot>Add list items here</slot>
</ul>

<style>
	.gallery {
		/* default values, can be modified via inline styles on a parent */
		--min-width: 300px;

		display: grid;
		gap: var(--gutter);
		grid-template-columns: 1fr;
		margin-block: 0;
		padding-inline-start: 0;
		position: relative;
	}

	@media screen and (min-width: 30em) {
		.gallery {
			grid-template-columns: repeat(auto-fit, minmax(var(--min-width), 1fr));
		}
	}

	[data-column-width~='small'] {
		--min-width: 180px;
	}

	[data-column-width~='large'] {
		--min-width: 500px;
		grid-template-columns: 1fr;
	}

	@media screen and (min-width: 40em) {
		[data-column-width~='large'] {
			grid-template-columns: repeat(auto-fit, minmax(var(--min-width), 1fr));
		}
	}

	.gallery :global(li) {
		flex-direction: column;
		flex: 1;
		display: flex;
		margin: 0; /* overrule default li spacing */
		position: relative;
	}

	.gallery[data-constrain] :global(li) {
		max-width: var(--content-width-default);
	}

	[data-column-width~='large'][data-constrain] :global(li) {
		max-width: var(--content-width-wide);
	}

	[data-align~='center'] {
		align-items: center;
	}

	[data-align~='center'][data-align~='justify'] {
		justify-content: center;
	}
</style>
