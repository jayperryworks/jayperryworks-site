{
	"name": "jay-perry-works-site",
	"description": "Jay Perry's website",
	"private": true,
	"repository": "https://github.com/jayperryworks/jayperryworks-site/",
	"version": "6.0.0",
	"type": "module",
	"workspaces": [
		"shared",
		"sites/personal",
		"sites/design"
	],
	"scripts": {
		"dev": "concurrently 'npm run personal dev' 'npm run design dev'",
		"design": "npm run --workspace=sites/design",
		"personal": "npm run --workspace=sites/personal",
		"shared": "npm run --workspace=shared"
	},
	"dependencies": {
		"concurrently": "^10.0.7",
		"svgo": "^4.0.2"
	}
}
