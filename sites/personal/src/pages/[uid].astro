---
/**
 * Top-level page template
 *
 * @param {object[]} body - the body blocks of the page
 * @param {string} title
 * @param {SEOContent} [seo] - SEO/metadata fields
 * @param {ThemeNames | Partial<Theme>} [theme] - color theme
 * @param {Footnote[]} [footnotes = []] - footnotes the body references
 */

// --- assets ---
import '@shared/styles/tokens/spacing.css';

// --- utils ---
import fetchContent from '@shared/lib/fetchContent';

// --- helpers ---
import { titleCase } from '@shared/lib/stringHelpers';

// --- components ---
import Layout from '@local/layouts/Layout.astro';
import BlockList from '@local/components/BlockList.astro';
import MainNav from '@local/components/navigation/MainNav.astro';
import MainFooter from '@local/components/navigation/MainFooter.astro';
import Footnotes from '@local/components/elements/Footnotes.astro';

// --- types ---
import type { SEOContent, Theme, ThemeNames } from '@shared/lib/types';
import type { Footnote } from '@shared/lib/kirby.types';

// --- data & pagination ---
// fetch data from content server

export async function getStaticPaths() {
	const pages = await fetchContent('pages', { env: 'dev' });

	return pages.reduce((result, page) => {
		// if this isn't a personal page, bail out
		if (!page.sites.includes('personal')) return result;

		// otherwise, return the data
		const {
			body,
			colorTheme: theme,
			footnotes,
			seo,
			sites,
			title,
			uuid: uid,
		} = page;

		// otherwise
		result.push({
			params: {
				uid,
			},
			props: {
				body,
				footnotes,
				seo,
				theme,
				title,
			},
		});

		return result;
	}, []);
}

// --- props ---
const { body, footnotes: notes = [], seo, theme, title } = Astro.props;
const { uid } = Astro.params;
---

<Layout
	pageTitle={title}
	{seo}
	{theme}
>
	<MainNav segment={uid} />
	<main id="main">
		<article>
			<BlockList
				{body}
				showLedeStyle
			/>
			<Footnotes {notes} />
		</article>
		<MainFooter />
	</main>
</Layout>

<style>
	article {
		padding-block: var(--space-xwide);
	}

	.title {
		padding-block-end: var(--space-wide);
		padding-inline: var(--space-outside);
		text-align: center;
		display: flex;
		flex-direction: column;
		gap: var(--space-narrow);
	}
</style>
