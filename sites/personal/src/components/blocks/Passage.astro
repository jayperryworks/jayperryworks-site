---
/**
 * Passage block component
 * - display formatted, flowing body text
 *
 * @param {string} text - text content
 * @param {boolean} [allowHTML=false] - render embedded html in markdown
 * @param {boolean} [centered=true] - center the passage in the available space
 * @param {string} [class] - classes to append to the container
 * @param {boolean} [footnotes] - uses footnotes
 * @param {'body' | 'display' | 'accent'} [typeFace] - type role for the text
 * @param {TypeScale} [typeSize] - size of the text
 * @param {'none' | 'pretty' | 'balance'} [wrap] - how to handle line wraps
 */

// --- assets ---
import '@shared/styles/tokens/type.css';
import '@shared/styles/utilities/contentWidth.css';
import '@shared/styles/utilities/type.css';

// --- components ---
import RenderedText from '@local/components/elements/RenderedText.astro';

// --- types ---
import type { TypeScale } from '@shared/lib/types';

// --- props and state ---
const {
	text: markdown,
	allowHTML = false,
	centered = true,
	class: className = '',
	footnotes = true,
	typeFace = 'body',
	typeSize = 'epsilon',
	wrap = 'pretty',
} = Astro.props;

const classList = ['passage', className].join(' ').trim();
---

<div
	class={classList}
	data-width={`default${centered ? ' centered' : ''}`}
	data-type={[
		`scale-${typeSize}`,
		typeFace !== 'body' ? `role-${typeFace}` : undefined,
		`wrap-${wrap}`,
	]
		.join(' ')
		.trim()}
>
	<slot>
		<RenderedText
			{markdown}
			{allowHTML}
			{footnotes}
		/>
	</slot>
</div>

<style>
	.passage {
		clear: both;
		position: relative;
		/* May need `overflow: hidden` here for sidenotes appearing at the bottom of a passage - but having it cuts off hanging punctuation. Will see if it becomes an issue. */
	}

	/* spacing */
	.passage > :global(*) {
		line-height: var(--type-leading-default);
		max-width: var(--content-width-default);
	}

	.passage > :global(* + *) {
		margin-block-start: 1em;
	}

	.passage :global(li + li) {
		margin-block-start: 1em;
	}

	/* add an icon after external links */
	@supports (mask: url('/assets/icons/external-link.svg') no-repeat 50% 50%) {
		/* display an 'external link' icon on any anchor with an absolute url */
		/* -> except for full urls pointing to my own domain (jayperry.works, jayperryworks.com) */
		.passage :global(a[href^='http']:not([href*='jayperry'])::after) {
			--size: 0.6em;

			background-color: currentColor;
			content: '';
			display: inline-block;
			height: var(--size);
			line-height: var(--type-leading-default);
			margin: 0 0.1em 0 0.25em;
			mask: url('/assets/icons/external-link.svg') no-repeat 50% 50%;
			position: relative;
			vertical-align: baseline;
			width: var(--size);
		}
	}
</style>
