---
/**
 * Pullquote block component
 * - display a stylized quote as a masked image
 *
 * @param {FormattedText} text - the text content, used as a fallback/alt
 * @param {string} [class] - classes to append to the container
 * @param {ColorRoles} [color] - the color for the image mask
 * @param {ImageField} [image] - the image to display, e.g. handwriting scan
 */

// --- assets ---
import '@shared/styles/tokens/spacing.css';
import '@shared/styles/utilities/visibility.css';
import '@shared/styles/utilities/contentWidth.css';

// --- utilities ---
import * as prismicHelpers from '@prismicio/helpers';
import { getImageUrl } from '@shared/lib/kirby/helpers';

// --- types ---
import type { ColorRoles, FormattedText } from '@shared/lib/types';
import type { ImageField } from '@prismicio/types';

// --- components ---
import Passage from '@shared/components/blocks/Passage.astro';
import RevealOnScroll from '@shared/components/meta/RevealOnScroll.astro';

// --- props ---
const { text, class: className = '', color = 'primary', image, prominence = 'default' } = Astro.props;

const imageSizes = ['small', 'medium', 'large', 'xlarge' ];

// create CSS variables for each image size and format, using the imageSizes above
const maskImageVariables = imageSizes.map((name) => {
	return Object.keys(image.versions[name].formats).map((format) => (
		`--image-${name}-${format}: url('${image.versions[name].formats[format]}');`
	)).join('');
});
---

<RevealOnScroll>
	<aside
		class={['pullquote', className].join(' ')}
		data-width={prominence}
		role="presentation"
		style={[
			`--aspect: ${image.width} / ${image.height};`,
			`--color: var(--color-${color});`,
			].join()}
	>
		<div class="wrapper" style={maskImageVariables.join('')}>
			<Passage
				class={image ? 'hide-visually' : ''}
				typeSize="delta"
				{text}
			/>
		</div>
	</aside>
</RevealOnScroll>

<style>
	.pullquote {
		container-name: pullquote;
		container-type: inline-size;
		display: flex;
	}

	.wrapper {
		--image-avif: var(--image-small-avif);
		--image-webp: var(--image-small-webp);

		aspect-ratio: var(--aspect);
		background-color: var(--color, currentColor);
		flex: 1;
		mask-image: var(--image-webp);
		mask-image: image-set(
			var(--image-avif) type("image/avif"),
			var(--image-webp) type("image/wep"),
		);
		mask-position: 50%;
		mask-repeat: no-repeat;
		mask-size: contain;
	}

	@container pullquote (width > 400px) {
		.wrapper {
			--image-avif: var(--image-medium-avif);
			--image-webp: var(--image-medium-webp);
		}
	}

	@container pullquote (width > 640px) {
		.wrapper {
			--image-avif: var(--image-large-avif);
			--image-webp: var(--image-large-webp);
		}
	}

	@container pullquote (width > 1000px) {
		.wrapper {
			--image-avif: var(--image-xlarge-avif);
			--image-webp: var(--image-xlarge-webp);
		}
	}
</style>
