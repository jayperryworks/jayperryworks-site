---
/**
 * Pullquote block component
 * - display a stylized quote as a masked image
 *
 * @param {string} text - the text content, used as a fallback/alt
 * @param {string} [class] - classes to append to the container
 * @param {ColorRoles} [color] - the color for the image mask
 * @param {ImageSource} [image] - the image to display, e.g. handwriting scan
 */

// --- assets ---
import '@shared/styles/tokens/spacing.css';
import '@shared/styles/utilities/visibility.css';
import '@shared/styles/utilities/contentWidth.css';

// --- types ---
import type { ColorRoles } from '@shared/lib/types';
import type { ImageSource } from '@shared/lib/kirby/types';

// --- components ---
import Passage from '@shared/components/blocks/Passage.astro';
import RevealOnScroll from '@shared/components/meta/RevealOnScroll.astro';

// --- props ---
const {
	image,
	text,
	class: className = '',
	color = 'primary',
	prominence = 'default',
} = Astro.props;

const { dimensions, versions } = image;

// create CSS variables for each image size and format, using the imageSizes above
const maskImageVariables = Object.keys(versions).map((width, index) => {
	if (index === 0) return false;

	return `--image-${width}: url('${versions[width]}');`;
}).filter(Boolean);
---

<RevealOnScroll>
	<aside
		class={['pullquote', className].join(' ')}
		data-width={prominence}
		role="presentation"
		style={[
			`--aspect: ${dimensions.ratio};`,
			`--color: var(--color-${color});`,
			].join()}
	>
		<div class="wrapper" style={maskImageVariables.join('')}>
			<Passage
				class={image ? 'hide-visually' : ''}
				typeSize="delta"
				{text}
			/>
		</div>
	</aside>
</RevealOnScroll>

<style>
	.pullquote {
		container-name: pullquote;
		container-type: inline-size;
		display: flex;
	}

	.wrapper {
		--image: var(--image-800);

		aspect-ratio: var(--aspect);
		background-color: var(--color, currentColor);
		flex: 1;
		mask-image: var(--image);
		mask-position: 50%;
		mask-repeat: no-repeat;
		mask-size: contain;
	}

	@container pullquote (width > 400px) {
		.wrapper {
			--image: var(--image-1024);
		}
	}

	@container pullquote (width > 800px) {
		.wrapper {
			--image: var(--image-1440);
		}
	}

	@container pullquote (width > 1024px) {
		.wrapper {
			--image: var(--image-2048);
		}
	}
</style>
