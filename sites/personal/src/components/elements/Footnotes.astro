---
/**
 * Footnotes component
 * @description Display footnotes as a list of popovers
 * @param {Footnote[]} notes - the notes data
 * @param {string} [class] - append classes to the container
 * @param {ContentWidth} [width='default'] - width of the list
 * @param {[key: string]: any} [attrs] - passed-in attributres
 */

// --- assets ---
import '@shared/styles/tokens/elevation.css';
import '@shared/styles/tokens/spacing.css';
import '@shared/styles/tokens/type.css';
import '@shared/styles/utilities/contentWidth.css';

// --- types ---
import type { Footnote } from '@shared/lib/kirby.types';
import type { ContentWidth } from '@shared/lib/types';

// --- components ---
import RenderedText from '@local/components/elements/RenderedText.astro';
import Heading from '@shared/components/blocks/Heading.astro';

// --- props ---
const {
	notes = [],
	class: className = '',
	width = 'default',
	...attrs
} = Astro.props;
---

{
	notes?.length > 0 && (
		<aside
			class={['footnotes', className].filter(Boolean).join(' ')}
			data-width={width}
		>
			<Heading
				class="title"
				level={2}
				size="delta"
			>
				Notes
			</Heading>
			<ol class="list">
				{notes.filter(Boolean).map(({ id, text: markdown }) => (
					<li
						class="item"
						id={`note-${id}`}
						popover="auto"
						position-anchor={`--reference-${id}`}
					>
						<RenderedText {markdown} />
					</li>
				))}
			</ol>
		</aside>
	)
}

<style>
	/* --- Fallback list styles --- */
	.footnotes {
		background-color: var(--color-well);
		border-radius: var(--border-radius);
		display: flex;
		flex-direction: column;
		gap: var(--space-narrow);
		padding: var(--space-medium);
	}

	.list {
		margin: 0;
		padding-inline-start: 1em;
	}

	.item {
		font-size: var(--type-scale-zeta);
		color: var(--color-secondary);
		font-family: var(--type-font-accent);
	}

	.item + .item {
		padding-block-start: var(--space-xnarrow);
	}

	.item::marker {
		font-style: italic;
		color: var(--color-highlight);
	}

	/* --- Popover styles --- */
	.footnotes:has(.item[popover]) {
		padding: 0;
		background-color: transparent;

		& :global(.title) {
			display: none;
		}
	}

	.list:has(.item[popover]) {
		list-style: none;
		padding: 0;
	}

	.item[popover] {
		--max-width: 30rem;
		--min-width: 12rem;

		background-color: var(--color-island);
		border-radius: var(--border-radius);
		border: 0;
		box-shadow: var(--elevation-medium);
		color: var(--color-secondary);
		inset-inline: var(--space-narrow);
		margin-block-start: var(--space-narrow);
		max-width: var(--max-width);
		min-width: var(--min-width);
		outline: 0;
		padding: var(--space-narrow) var(--space-medium);
	}

	@supports (anchor-name: --x) {
		.item[popover] {
			position-area: bottom span-all;
			position-try-fallbacks: flip-block, flip-inline;
			position: absolute;
		}
	}

	@supports not (anchor-name: --x) {
		.item[popover] {
			inset-block-start: 50%;
			inset-inline-start: 50%;
			position: fixed;
			transform: translate(-50%, -50%);

			&::backdrop {
				background-color: oklch(from var(--color-surface) l c h / 0.4);
			}
		}
	}

	/* -- Footnote references (appearing inline) --- */
	:global(.footnote-reference) {
		--color: var(--color-secondary);
		--size: 1.6em;

		background-color: transparent;
		border-radius: 1000px;
		border: 1px solid var(--color);
		cursor: pointer;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-family: var(--type-font-accent);
		font-size: var(--type-scale-eta);
		height: var(--size);
		position: relative;
		text-align: center;
		text-decoration: none;
		transform: translateY(20%); /* scoot down a little */
		transition-duration: 0.25s;
		transition-property: border-color, background-color;
		transition-timing-function: ease-in-out;
		vertical-align: top;
		width: var(--size);
		padding: 0;

		&::before {
			--icon-size: 70%;

			background-color: var(--color);
			border-radius: 1000px;
			content: '';
			display: block;
			height: var(--icon-size);
			mask-image: url('/assets/icons/asterisk.svg');
			mask-position: 50% 50%;
			mask-repeat: no-repeat;
			mask-size: contain;
			transition: background-color 0.25s ease-in-out;
			width: var(--icon-size);
		}
	}

	:global(.footnote-reference):hover,
	:global(.footnote-reference):active {
		--color: var(--color-highlight);
	}
</style>
